/-!
# Central limit theorem for finite-state Markov chains

The Markov property of a finite-state chain specified by its path probabilities, in integral
and in conditional form, and the central limit theorem for a stationary chain with a positive
transition matrix. The chain is the one of `CKSD.Bayes.MonteCarlo`.

## Main definitions

* `CKSD.chainFiltration`: the natural filtration of a finite-state chain.

## Main results

* `CKSD.condExp_comp_pair_succ_ae_eq`: the Markov property in conditional form.
* `CKSD.exists_sub_mulVec_eq_of_pos`: the Poisson equation for a positive transition matrix.
* `CKSD.tendstoInDistribution_finite_markov_chain_sum`: the central limit theorem for a
  stationary chain with a positive transition matrix (GAPS 104.24), via the Poisson equation
  and the martingale central limit theorem `CKSD.tendstoInDistribution_sum_of_sum_condVar_le`.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators

namespace CKSD

section Ergodic

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- One-step Markov property for a function of the last two states of a finite-state chain given
by its path probabilities: for a function `F` of the prefix `(X 0, …, X n)`,
`𝔼[F · φ(X n, X (n+1))] = 𝔼[F · ∑_y K(X n, y) φ(X n, y)]`. -/
theorem integral_mul_comp_pair_succ_eq {Ω : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (K : Matrix ι ι ℝ)
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n))
    (hstep : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n + 1, X i ω = path i} =
        μ.real {ω | ∀ i ≤ n, X i ω = path i} * K (path n) (path (n + 1)))
    (n : ℕ) (F : (Fin (n + 1) → ι) → ℝ) (φ : ι → ι → ℝ) :
    ∫ ω, F (fun i : Fin (n + 1) ↦ X i ω) * φ (X n ω) (X (n + 1) ω) ∂μ =
      ∫ ω, F (fun i : Fin (n + 1) ↦ X i ω) * ∑ y, K (X n ω) y * φ (X n ω) y ∂μ := by
  set G : ι → (Fin (n + 1) → ι) → ℝ := fun x z ↦ F z * if z (Fin.last n) = x then 1 else 0
    with hG
  have hpre := measurable_finChainPrefix X hX n
  have hL (ω : Ω) : F (fun i : Fin (n + 1) ↦ X i ω) * φ (X n ω) (X (n + 1) ω) =
      ∑ x, G x (fun i : Fin (n + 1) ↦ X i ω) * φ x (X (n + 1) ω) := by
    simp [hG, Fin.val_last, mul_ite, ite_mul]
  have hR (ω : Ω) : F (fun i : Fin (n + 1) ↦ X i ω) * ∑ y, K (X n ω) y * φ (X n ω) y =
      ∑ x, G x (fun i : Fin (n + 1) ↦ X i ω) * Matrix.mulVec K (φ x) (X n ω) := by
    simp [hG, Fin.val_last, mul_ite, ite_mul, Matrix.mulVec, dotProduct]
  simp_rw [hL, hR]
  rw [integral_finsetSum _ fun x _ ↦ integrable_comp_of_finite μ
      (fun ω ↦ ((fun i : Fin (n + 1) ↦ X i ω), X (n + 1) ω)) (hpre.prodMk (hX (n + 1)))
      (fun z ↦ G x z.1 * φ x z.2),
    integral_finsetSum _ fun x _ ↦ integrable_comp_of_finite μ
      (fun ω ↦ ((fun i : Fin (n + 1) ↦ X i ω), X n ω)) (hpre.prodMk (hX n))
      (fun z ↦ G x z.1 * Matrix.mulVec K (φ x) z.2)]
  exact Finset.sum_congr rfl fun x _ ↦
    integral_mul_comp_succ_eq_mulVec μ K X hX hstep n (G x) (φ x)

/-- `k`-step Markov property from the initial state of a finite-state chain given by its path
probabilities: `𝔼[a(X 0) v(X k)] = 𝔼[a(X 0) (Kᵏ v)(X 0)]`. -/
theorem integral_mul_comp_eq_pow_mulVec {Ω : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (K : Matrix ι ι ℝ)
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n))
    (hstep : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n + 1, X i ω = path i} =
        μ.real {ω | ∀ i ≤ n, X i ω = path i} * K (path n) (path (n + 1)))
    (a v : ι → ℝ) (k : ℕ) :
    ∫ ω, a (X 0 ω) * v (X k ω) ∂μ = ∫ ω, a (X 0 ω) * Matrix.mulVec (K ^ k) v (X 0 ω) ∂μ := by
  induction k generalizing v with
  | zero => simp
  | succ k ih =>
    have h := integral_mul_comp_succ_eq_mulVec μ K X hX hstep k (fun z ↦ a (z 0)) v
    simp only [Fin.val_zero] at h
    rw [h, ih, pow_succ, ← Matrix.mulVec_mulVec]

/-- The natural filtration of a finite-state process: its `n`-th `σ`-algebra is generated by the
prefix `(X 0, …, X n)`. -/
def chainFiltration {Ω : Type*} [m : MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n)) : Filtration ℕ m where
  seq n := MeasurableSpace.comap (fun ω (i : Fin (n + 1)) ↦ X i ω) inferInstance
  mono' i j hij := by
    have : (fun ω (l : Fin (i + 1)) ↦ X l ω) =
        (fun z : Fin (j + 1) → ι ↦ fun l : Fin (i + 1) ↦ z (Fin.castLE (by omega) l)) ∘
          (fun ω (l : Fin (j + 1)) ↦ X l ω) := rfl
    simp only
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_of_finite _).comap_le
  le' n := (measurable_finChainPrefix X hX n).comap_le

omit [DecidableEq ι] in
/-- A real function of the prefix `(X 0, …, X n)` is measurable for the `n`-th `σ`-algebra of
the natural filtration. -/
theorem measurable_chainFiltration {Ω : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n)) (n : ℕ) (G : (Fin (n + 1) → ι) → ℝ) :
    StronglyMeasurable[chainFiltration X hX n] fun ω ↦ G fun i : Fin (n + 1) ↦ X i ω :=
  ((measurable_of_finite G).comp (comap_measurable _)).stronglyMeasurable

/-- Markov property in conditional form: given the prefix `(X 0, …, X n)`, the conditional
expectation of `φ(X n, X (n+1))` is `∑_y K(X n, y) φ(X n, y)`. -/
theorem condExp_comp_pair_succ_ae_eq {Ω : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (K : Matrix ι ι ℝ)
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n))
    (hstep : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n + 1, X i ω = path i} =
        μ.real {ω | ∀ i ≤ n, X i ω = path i} * K (path n) (path (n + 1)))
    (n : ℕ) (φ : ι → ι → ℝ) :
    μ[fun ω ↦ φ (X n ω) (X (n + 1) ω) | chainFiltration X hX n] =ᵐ[μ]
      fun ω ↦ ∑ y, K (X n ω) y * φ (X n ω) y := by
  have hpre := measurable_finChainPrefix X hX n
  refine (ae_eq_condExp_of_forall_setIntegral_eq ((chainFiltration X hX).le n)
    (integrable_comp_of_finite μ (fun ω ↦ (X n ω, X (n + 1) ω)) ((hX n).prodMk (hX (n + 1)))
      fun z ↦ φ z.1 z.2) (fun s _ _ ↦ (integrable_comp_of_finite μ (X n) (hX n)
        fun x ↦ ∑ y, K x y * φ x y).integrableOn) (fun s hs _ ↦ ?_) ?_).symm
  · obtain ⟨S, -, rfl⟩ := hs
    have hS : MeasurableSet S := (Set.toFinite S).measurableSet
    rw [← integral_indicator (hpre hS), ← integral_indicator (hpre hS)]
    have h := integral_mul_comp_pair_succ_eq μ K X hX hstep n (S.indicator 1) φ
    convert h.symm using 2 with ω ω
    all_goals
      funext ω
      by_cases hω : (fun i : Fin (n + 1) ↦ X i ω) ∈ S <;> simp [hω]
  · exact (measurable_chainFiltration X hX n
      (fun z ↦ ∑ y, K (z (Fin.last n)) y * φ (z (Fin.last n)) y)).aestronglyMeasurable

/-- Geometric decay of `Kᵏ g` for a positive stochastic matrix `K` with invariant law `π` and a
`π`-centred `g`. -/
theorem exists_abs_pow_mulVec_le_of_pos (π : ι → ℝ) (K : Matrix ι ι ℝ)
    (hπ : ∀ x, 0 < π x) (hπ1 : ∑ x, π x = 1) (hK : ∀ x y, 0 < K x y)
    (hK1 : ∀ x, ∑ y, K x y = 1) (hstat : ∀ y, ∑ x, π x * K x y = π y)
    (g : ι → ℝ) (hg : ∑ x, π x * g x = 0) :
    ∃ r : ℝ, 0 ≤ r ∧ r < 1 ∧ ∀ k x, |Matrix.mulVec (K ^ k) g x| ≤ (∑ y, |g y|) * r ^ k := by
  cases isEmpty_or_nonempty ι with
  | inl _ => exact ⟨0, le_rfl, one_pos, fun _ x ↦ isEmptyElim x⟩
  | inr _ => ?_
  obtain ⟨x₀⟩ := (inferInstance : Nonempty ι)
  set m := (Finset.univ : Finset (ι × ι)).inf' ⟨(x₀, x₀), Finset.mem_univ _⟩
    (fun z ↦ K z.1 z.2) with hm
  have hm_pos : 0 < m := (Finset.lt_inf'_iff _).2 fun z _ ↦ hK z.1 z.2
  have hm_le (u z : ι) : m ≤ K u z :=
    Finset.inf'_le (fun z : ι × ι ↦ K z.1 z.2) (Finset.mem_univ (u, z))
  have hm_one : m ≤ 1 := by
    have := Finset.single_le_sum (f := fun z ↦ K x₀ z) (fun z _ ↦ (hK x₀ z).le)
      (Finset.mem_univ x₀)
    linarith [hm_le x₀ x₀, hK1 x₀]
  have hπle (y : ι) : π y ≤ 1 := hπ1 ▸ Finset.single_le_sum (f := π)
    (fun z _ ↦ (hπ z).le) (Finset.mem_univ y)
  have hmin (u z : ι) : m * π z ≤ K u z :=
    (mul_le_of_le_one_right hm_pos.le (hπle z)).trans (hm_le u z)
  refine ⟨1 - m, by linarith, by linarith, fun k x ↦ ?_⟩
  have hrw : Matrix.mulVec (K ^ k) g x = ∑ y, ((K ^ k) x y - π y) * g y := by
    simp only [Matrix.mulVec, dotProduct, sub_mul, Finset.sum_sub_distrib, hg, sub_zero]
  rw [hrw, Finset.sum_mul]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun y _ ↦ ?_)
  rw [abs_mul, mul_comm]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  simpa using abs_sum_pow_sub_le_of_minorization π K (fun z ↦ (hπ z).le) hπ1
    hK1 hstat m hmin {y} k x

/-- Poisson equation for a positive stochastic matrix: `u = ∑ₖ Kᵏ g` solves `u - K u = g`, and
`K u = ∑ₖ Kᵏ⁺¹ g`. -/
theorem exists_sub_mulVec_eq_of_pos (π : ι → ℝ) (K : Matrix ι ι ℝ)
    (hπ : ∀ x, 0 < π x) (hπ1 : ∑ x, π x = 1) (hK : ∀ x y, 0 < K x y)
    (hK1 : ∀ x, ∑ y, K x y = 1) (hstat : ∀ y, ∑ x, π x * K x y = π y)
    (g : ι → ℝ) (hg : ∑ x, π x * g x = 0) :
    ∃ u : ι → ℝ, (∀ x, u x - Matrix.mulVec K u x = g x) ∧
      ∀ x, HasSum (fun k ↦ Matrix.mulVec (K ^ (k + 1)) g x) (Matrix.mulVec K u x) := by
  obtain ⟨r, hr0, hr1, hdecay⟩ := exists_abs_pow_mulVec_le_of_pos π K hπ hπ1 hK hK1 hstat g hg
  have hsum (x : ι) : Summable fun k ↦ Matrix.mulVec (K ^ k) g x :=
    Summable.of_norm_bounded
      ((summable_geometric_of_lt_one hr0 hr1).mul_left (∑ y, |g y|))
      fun k ↦ by simpa [Real.norm_eq_abs] using hdecay k x
  set w : ι → ℝ := fun x ↦ ∑' k, Matrix.mulVec (K ^ k) g x with hw
  have hKw (x : ι) : HasSum (fun k ↦ Matrix.mulVec (K ^ (k + 1)) g x) (Matrix.mulVec K w x) := by
    have h1 : HasSum (fun k ↦ ∑ y, K x y * Matrix.mulVec (K ^ k) g y)
        (∑ y, K x y * w y) := hasSum_sum fun y _ ↦ (hsum y).hasSum.mul_left (K x y)
    convert h1 using 1
    · funext k
      rw [pow_succ', ← Matrix.mulVec_mulVec]
      rfl
    · simp [Matrix.mulVec, dotProduct]
  refine ⟨w, fun x ↦ ?_, hKw⟩
  rw [← (hKw x).tsum_eq]
  simp only [hw]
  rw [(hsum x).tsum_eq_zero_add]
  simp

omit [DecidableEq ι] in
/-- A real function of a measurable finite-valued map is in every `Lᵖ`. -/
private theorem memLp_comp_of_fintype {Ω β : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    [IsFiniteMeasure μ] [Fintype β] [MeasurableSpace β] [MeasurableSingletonClass β]
    (Y : Ω → β) (hY : Measurable Y) (F : β → ℝ) (p : ℝ≥0∞) :
    MemLp (fun ω ↦ F (Y ω)) p μ :=
  MemLp.of_bound ((measurable_of_finite F).comp hY).aestronglyMeasurable (∑ b, |F b|)
    (ae_of_all _ fun ω ↦ by
      simpa [Real.norm_eq_abs] using Finset.single_le_sum (f := fun b ↦ |F b|)
        (fun _ _ ↦ abs_nonneg _) (Finset.mem_univ (Y ω)))

/-- Martingale central limit theorem for the increments of a stationary finite-state chain with a
positive transition matrix `K`: for every `u`, `n^{-1/2} ∑_{i<n} (u(X_{i+1}) - (K u)(X_i))`
converges in law to the centred normal law with variance
`∑ₓ π(x) ∑_y K(x,y) (u(y) - (K u)(x))²`. The conditional variances are functions of the current
state, whose averages converge by the ergodic theorem, and the increments are bounded, so the
conditional Lindeberg terms vanish for large `n`. -/
private theorem tendstoInDistribution_sum_markovIncrement_div_sqrt {Ω : Type*}
    [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n))
    (π : ι → ℝ) (K : Matrix ι ι ℝ)
    (hπ : ∀ x, 0 < π x) (hπ1 : ∑ x, π x = 1)
    (hK : ∀ x y, 0 < K x y) (hK1 : ∀ x, ∑ y, K x y = 1)
    (hstat : ∀ y, (∑ x, π x * K x y) = π y)
    (hstep : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n + 1, X i ω = path i} =
        μ.real {ω | ∀ i ≤ n, X i ω = path i} * K (path n) (path (n + 1))) (u : ι → ℝ) :
    TendstoInDistribution (fun (n : ℕ) ω ↦ ∑ i ∈ Finset.range n,
        (u (X (i + 1) ω) - Matrix.mulVec K u (X i ω)) / Real.sqrt n) atTop id (fun _ ↦ μ)
      (gaussianReal 0 (∑ x, π x * ∑ y, K x y * (u y - Matrix.mulVec K u x) ^ 2).toNNReal) := by
  set Ku := Matrix.mulVec K u with hKudef
  set w : ι → ℝ := fun x ↦ ∑ y, K x y * (u y - Ku x) ^ 2 with hw
  set v := ∑ x, π x * w x with hv
  have hw0 (x : ι) : 0 ≤ w x := Finset.sum_nonneg fun y _ ↦ mul_nonneg (hK x y).le (sq_nonneg _)
  set Fn : ℕ → Filtration ℕ (inferInstance : MeasurableSpace Ω) := fun _ ↦ chainFiltration X hX
    with hFn
  set Xa : ℕ → ℕ → Ω → ℝ := fun n i ω ↦ (u (X (i + 1) ω) - Ku (X i ω)) / Real.sqrt n with hXa
  set σ2 : ℕ → ℕ → Ω → ℝ := fun n i ω ↦ w (X i ω) / n with hσ2
  set ℓ : ℝ → ℕ → ℕ → Ω → ℝ := fun ε n i ω ↦ ∑ y, K (X i ω) y *
    (if ε < |(u y - Ku (X i ω)) / Real.sqrt n| then ((u y - Ku (X i ω)) / Real.sqrt n) ^ 2
      else 0) with hℓ
  have hsq (n : ℕ) : Real.sqrt n ^ 2 = n := Real.sq_sqrt (Nat.cast_nonneg n)
  have hv0 : 0 ≤ v := Finset.sum_nonneg fun x _ ↦ mul_nonneg (hπ x).le (hw0 x)
  have hwle (x : ι) : w x ≤ ∑ x, w x :=
    Finset.single_le_sum (f := w) (fun z _ ↦ hw0 z) (Finset.mem_univ x)
  have hB : ∀ n : ℕ, ∀ᵐ ω ∂μ, ∑ i ∈ Finset.range n, σ2 n i ω ≤ ∑ x, w x := by
    refine fun n ↦ ae_of_all _ fun ω ↦ ?_
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simpa using Finset.sum_nonneg fun x _ ↦ hw0 x
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    calc ∑ i ∈ Finset.range n, σ2 n i ω ≤ ∑ _i ∈ Finset.range n, (∑ x, w x) / n :=
          Finset.sum_le_sum fun i _ ↦ div_le_div_of_nonneg_right (hwle _) hn'.le
      _ = ∑ x, w x := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          field_simp
  have hV : TendstoInMeasure μ (fun n ω ↦ ∑ i ∈ Finset.range n, σ2 n i ω) atTop
      fun _ ↦ v := by
    have hwc : ∑ x, π x * (w x - v) = 0 := by
      simp only [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hπ1, one_mul, hv, sub_self]
    obtain ⟨u', hu', -⟩ := exists_sub_mulVec_eq_of_pos π K hπ hπ1 hK hK1 hstat _ hwc
    have hae := ae_tendsto_sampleAverage_of_sub_mulVec_eq μ K (fun x y ↦ (hK x y).le) hK1 X hX
      hstep w v u' hu'
    refine tendstoInMeasure_of_tendsto_ae (fun n ↦ (Finset.measurable_sum _ fun i _ ↦
      ((measurable_of_finite w).comp (hX i)).div_const _).aestronglyMeasurable) ?_
    filter_upwards [hae] with ω hω
    refine hω.congr fun n ↦ ?_
    simp only [sampleAverage, smul_eq_mul, hσ2, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ ↦ by ring
  have hL : ∀ ε > 0, Tendsto (fun n : ℕ ↦ ∫ ω, ∑ i ∈ Finset.range n, ℓ ε n i ω ∂μ) atTop
      (𝓝 0) := by
    intro ε hε
    set A := ∑ x, ∑ y, |u y - Ku x| with hA
    have hAle (x y : ι) : |u y - Ku x| ≤ A :=
      (Finset.single_le_sum (f := fun y ↦ |u y - Ku x|) (fun _ _ ↦ abs_nonneg _)
        (Finset.mem_univ y)).trans (Finset.single_le_sum
          (f := fun x ↦ ∑ y, |u y - Ku x|) (fun _ _ ↦ Finset.sum_nonneg fun _ _ ↦
            abs_nonneg _) (Finset.mem_univ x))
    have hA0 : 0 ≤ A / ε := div_nonneg (Finset.sum_nonneg fun _ _ ↦ Finset.sum_nonneg
      fun _ _ ↦ abs_nonneg _) hε.le
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_gt_atTop ⌈(A / ε) ^ 2⌉₊] with n hn
    have hsn : A / ε < Real.sqrt n := by
      rw [Real.lt_sqrt hA0]
      exact (Nat.le_ceil _).trans_lt (by exact_mod_cast hn)
    have hsn0 : 0 < Real.sqrt n := hA0.trans_lt hsn
    have hzero (i : ℕ) (ω : Ω) : ℓ ε n i ω = 0 := by
      refine Finset.sum_eq_zero fun y _ ↦ ?_
      have hnot : ¬ ε < |(u y - Ku (X i ω)) / Real.sqrt n| := by
        rw [not_lt, abs_div, abs_of_pos hsn0, div_le_iff₀ hsn0]
        rw [div_lt_iff₀ hε] at hsn
        linarith [hAle (X i ω) y]
      simp [hnot]
    simp [hzero]
  exact tendstoInDistribution_sum_of_sum_condVar_le μ Fn Xa σ2 ℓ (fun n ↦ n)
    (fun n i ↦ measurable_chainFiltration X hX (i + 1)
      (fun z ↦ (u (z (Fin.last (i + 1))) - Ku (z ⟨i, by omega⟩)) / Real.sqrt n))
    (fun n i ↦ memLp_comp_of_fintype μ (fun ω ↦ (X i ω, X (i + 1) ω))
      ((hX i).prodMk (hX (i + 1))) (fun z ↦ (u z.2 - Ku z.1) / Real.sqrt n) 2)
    (fun n i ↦ by
      refine (condExp_comp_pair_succ_ae_eq μ K X hX hstep i
        (fun x y ↦ (u y - Ku x) / Real.sqrt n)).trans (ae_of_all _ fun ω ↦ ?_)
      simp only [Pi.zero_apply, mul_div_assoc', ← Finset.sum_div, mul_sub,
        Finset.sum_sub_distrib, ← Finset.sum_mul, hK1, one_mul]
      simp [hKudef, Matrix.mulVec, dotProduct])
    (fun n i ↦ measurable_chainFiltration X hX i (fun z ↦ w (z (Fin.last i)) / n))
    (fun n i ↦ by
      refine ((condExp_comp_pair_succ_ae_eq μ K X hX hstep i
        (fun x y ↦ ((u y - Ku x) / Real.sqrt n) ^ 2)).trans (ae_of_all _ fun ω ↦ ?_)).symm
      simp only [hσ2, hw, div_pow, hsq, mul_div_assoc', Finset.sum_div])
    (fun ε _ n i ↦ (condExp_comp_pair_succ_ae_eq μ K X hX hstep i
        (fun x y ↦ if ε < |(u y - Ku x) / Real.sqrt n| then ((u y - Ku x) / Real.sqrt n) ^ 2
          else 0)).symm)
    (fun n i ↦ ae_of_all _ fun ω ↦ div_nonneg (hw0 _) (Nat.cast_nonneg n))
    hv0 hB hV hL

/-- For a stationary finite-state chain with a positive transition matrix and a solution `u` of
the Poisson equation `u - K u = f - m`, the normalized sample averages `√n (n⁻¹ ∑_{i<n} f(Xᵢ) - m)`
converge in law to the centred normal law with variance
`∑ₓ π(x) ∑_y K(x,y) (u(y) - (K u)(x))²`: they differ from the normalized martingale of
`tendstoInDistribution_sum_markovIncrement_div_sqrt` by `(u(X₀) - u(Xₙ)) / √n`. -/
private theorem tendstoInDistribution_sqrt_mul_sampleAverage_sub_of_poisson {Ω : Type*}
    [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n))
    (π : ι → ℝ) (K : Matrix ι ι ℝ)
    (hπ : ∀ x, 0 < π x) (hπ1 : ∑ x, π x = 1)
    (hK : ∀ x y, 0 < K x y) (hK1 : ∀ x, ∑ y, K x y = 1)
    (hstat : ∀ y, (∑ x, π x * K x y) = π y)
    (hstep : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n + 1, X i ω = path i} =
        μ.real {ω | ∀ i ≤ n, X i ω = path i} * K (path n) (path (n + 1)))
    (f : ι → ℝ) (m : ℝ) (u : ι → ℝ) (hu : ∀ x, u x - Matrix.mulVec K u x = f x - m) :
    TendstoInDistribution (fun (n : ℕ) ω ↦ Real.sqrt n * (sampleAverage (fun i ω ↦ f
        (X i ω)) n ω - m)) atTop id (fun _ ↦ μ)
      (gaussianReal 0 (∑ x, π x * ∑ y, K x y * (u y - Matrix.mulVec K u x) ^ 2).toNNReal) := by
  set Ku := Matrix.mulVec K u with hKudef
  have hsq (n : ℕ) : Real.sqrt n ^ 2 = n := Real.sq_sqrt (Nat.cast_nonneg n)
  have hmart := tendstoInDistribution_sum_markovIncrement_div_sqrt μ X hX π K hπ hπ1 hK hK1 hstat
    hstep u
  -- the boundary term `(u(X₀) - u(Xₙ)) / √n` is negligible
  set R : ℕ → Ω → ℝ := fun n ω ↦ (u (X 0 ω) - u (X n ω)) / Real.sqrt n with hR
  set U := ∑ y, |u y| with hU
  have hu_le (y : ι) : |u y| ≤ U :=
    Finset.single_le_sum (f := fun y ↦ |u y|) (fun _ _ ↦ abs_nonneg _) (Finset.mem_univ y)
  have hRm (n : ℕ) : Measurable (R n) :=
    (((measurable_of_finite u).comp (hX 0)).sub ((measurable_of_finite u).comp (hX n))).div_const _
  have hRlim : TendstoInMeasure μ R atTop fun _ ↦ 0 := by
    refine tendstoInMeasure_of_tendsto_ae (fun n ↦ (hRm n).aestronglyMeasurable)
      (ae_of_all _ fun ω ↦ ?_)
    have hsqrt : Tendsto (fun n : ℕ ↦ Real.sqrt n) atTop atTop :=
      Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop
    refine squeeze_zero_norm (fun n ↦ ?_)
      ((tendsto_const_nhds (x := 2 * U)).div_atTop hsqrt)
    have h0 := hu_le (X 0 ω)
    have h1 := hu_le (X n ω)
    rw [Real.norm_eq_abs, abs_div, abs_of_nonneg (Real.sqrt_nonneg _)]
    exact div_le_div_of_nonneg_right ((abs_sub _ _).trans (by linarith))
      (Real.sqrt_nonneg _)
  have hsum := hmart.add_of_tendstoInMeasure_const hRlim fun n ↦ (hRm n).aemeasurable
  have hlim : (fun ω : ℝ ↦ id ω + (0 : ℝ)) = id := by funext ω; simp
  rw [hlim] at hsum
  convert hsum using 1
  funext n ω
  simp only [Pi.add_apply, hR]
  have hdec : ∑ i ∈ Finset.range n, f (X i ω) - n * m =
      ∑ i ∈ Finset.range n, (u (X (i + 1) ω) - Ku (X i ω)) + (u (X 0 ω) - u (X n ω)) := by
    have hi (i : ℕ) : f (X i ω) - m = (u (X i ω) - u (X (i + 1) ω)) +
        (u (X (i + 1) ω) - Ku (X i ω)) := by
      linarith [hu (X i ω)]
    have : ∑ i ∈ Finset.range n, f (X i ω) - n * m = ∑ i ∈ Finset.range n, (f (X i ω) - m) := by
      rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    rw [this]
    simp_rw [hi, Finset.sum_add_distrib, Finset.sum_range_sub']
    ring
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  have hsn0 : 0 < Real.sqrt n := Real.sqrt_pos.2 (by exact_mod_cast hn)
  rw [← Finset.sum_div, ← add_div, ← hdec, sampleAverage, smul_eq_mul, eq_div_iff hsn0.ne']
  have hn0 : (n : ℝ) ≠ 0 := by positivity
  have := hsq n
  field_simp
  rw [this]

/-- GAPS 104.24: central limit theorem for a stationary Markov chain on a finite space with a
positive transition matrix `K` and invariant law `π`. The series of autocovariances of `f(Xₖ)`
converges absolutely, and `√n (n⁻¹ ∑_{i<n} f(Xᵢ) - π f)` converges in law to the centred normal
law with variance `σ² = Var f(X₀) + 2 ∑_{k ≥ 1} Cov(f(X₀), f(Xₖ))`. The proof solves the Poisson
equation `u - K u = f - π f` by `u = ∑ₖ Kᵏ (f - π f)`, writes the centred sums as a martingale
plus a bounded remainder, and identifies `σ²` with the martingale variance
`∑ₓ π(x) ∑_y K(x,y) (u(y) - (K u)(x))²`. -/
theorem tendstoInDistribution_finite_markov_chain_sum {Ω : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ι] [MeasurableSingletonClass ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ι) (hX : ∀ n, Measurable (X n))
    (π : ι → ℝ) (K : Matrix ι ι ℝ)
    (hπ : ∀ x, 0 < π x) (hπ1 : ∑ x, π x = 1)
    (hK : ∀ x y, 0 < K x y) (hK1 : ∀ x, ∑ y, K x y = 1)
    (hstat : ∀ y, (∑ x, π x * K x y) = π y)
    (hlaw : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n, X i ω = path i} = π (path 0) *
        ∏ i ∈ Finset.range n, K (path i) (path (i + 1)))
    (f : ι → ℝ) :
    let m := ∑ x, π x * f x;
    let sigmaSq := Var[f ∘ X 0; μ] +
      2 * ∑' k : ℕ, cov[f ∘ X 0, f ∘ X (k + 1); μ];
    Summable (fun k : ℕ ↦ |cov[f ∘ X 0, f ∘ X (k + 1); μ]|) ∧
      TendstoInDistribution (fun (n : ℕ) ω ↦ Real.sqrt n * (sampleAverage (fun i ω ↦ f
        (X i ω)) n ω - m)) atTop id (fun _ ↦ μ)
        (gaussianReal 0 (Real.toNNReal sigmaSq)) := by
  intro m sigmaSq
  have hstep : ∀ n : ℕ, ∀ path : ℕ → ι,
      μ.real {ω | ∀ i ≤ n + 1, X i ω = path i} =
        μ.real {ω | ∀ i ≤ n, X i ω = path i} * K (path n) (path (n + 1)) := by
    intro n path
    rw [hlaw, hlaw, Finset.prod_range_succ, mul_assoc]
  set g : ι → ℝ := fun x ↦ f x - m with hg
  have hgc : ∑ x, π x * g x = 0 := by
    simp only [hg, mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hπ1, one_mul, m,
      sub_self]
  obtain ⟨r, hr0, hr1, hdecay⟩ := exists_abs_pow_mulVec_le_of_pos π K hπ hπ1 hK hK1 hstat g hgc
  obtain ⟨u, hu, hKu⟩ := exists_sub_mulVec_eq_of_pos π K hπ hπ1 hK hK1 hstat g hgc
  -- moments of the stationary chain
  have hE0 (a : ι → ℝ) : ∫ ω, a (X 0 ω) ∂μ = ∑ x, π x * a x := by
    rw [integral_comp_eq_sum_measureReal μ (X 0) (hX 0) a]
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    have hset : X 0 ⁻¹' {x} = {ω | ∀ i ≤ 0, X i ω = (fun _ ↦ x) i} := by
      ext ω; simp
    rw [hset, hlaw]
    simp
  have hEk (a v : ι → ℝ) (k : ℕ) : ∫ ω, a (X 0 ω) * v (X k ω) ∂μ =
      ∑ x, π x * (a x * Matrix.mulVec (K ^ k) v x) := by
    rw [integral_mul_comp_eq_pow_mulVec μ K X hX hstep a v k,
      hE0 fun x ↦ a x * Matrix.mulVec (K ^ k) v x]
  have hEv (v : ι → ℝ) (k : ℕ) : ∫ ω, v (X k ω) ∂μ = ∑ x, π x * v x := by
    have h := hEk 1 v k
    simp only [Pi.one_apply, one_mul] at h
    rw [h]
    simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
    rw [Finset.sum_comm]
    simp_rw [← mul_assoc, ← Finset.sum_mul, sum_mul_pow_eq_of_stationary hstat k]
  have hmean (k : ℕ) : μ[f ∘ X k] = m := hEv f k
  have hcov (k : ℕ) : cov[f ∘ X 0, f ∘ X (k + 1); μ] =
      ∑ x, π x * (g x * Matrix.mulVec (K ^ (k + 1)) g x) := by
    rw [covariance, hmean, hmean]
    exact hEk g g (k + 1)
  have hvar : Var[f ∘ X 0; μ] = ∑ x, π x * g x ^ 2 := by
    rw [variance_eq_integral ((measurable_of_finite f).comp (hX 0)).aemeasurable, hmean]
    exact hE0 fun x ↦ g x ^ 2
  -- summability of the autocovariances
  set Cg := ∑ y, |g y| with hCg
  have hcovle (k : ℕ) : |cov[f ∘ X 0, f ∘ X (k + 1); μ]| ≤ Cg * Cg * r ^ (k + 1) := by
    rw [hcov]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ x, |π x * (g x * Matrix.mulVec (K ^ (k + 1)) g x)|
        ≤ ∑ x, |g x| * (Cg * r ^ (k + 1)) := Finset.sum_le_sum fun x _ ↦ by
          rw [abs_mul, abs_mul, abs_of_pos (hπ x)]
          have hπle : π x ≤ 1 := hπ1 ▸ Finset.single_le_sum (f := π)
            (fun z _ ↦ (hπ z).le) (Finset.mem_univ x)
          calc π x * (|g x| * |Matrix.mulVec (K ^ (k + 1)) g x|)
              ≤ 1 * (|g x| * (Cg * r ^ (k + 1))) := by
                gcongr
                exact hdecay (k + 1) x
            _ = _ := one_mul _
      _ = Cg * Cg * r ^ (k + 1) := by rw [← Finset.sum_mul, ← hCg]; ring
  have hsumm : Summable fun k : ℕ ↦ |cov[f ∘ X 0, f ∘ X (k + 1); μ]| :=
    Summable.of_nonneg_of_le (fun _ ↦ abs_nonneg _) hcovle
      (((summable_geometric_of_lt_one hr0 hr1).mul_left (Cg * Cg * r)).congr fun k ↦ by ring)
  refine ⟨hsumm, ?_⟩
  -- the asymptotic variance through the Poisson solution
  set Ku := Matrix.mulVec K u with hKudef
  set w : ι → ℝ := fun x ↦ ∑ y, K x y * (u y - Ku x) ^ 2 with hw
  set v := ∑ x, π x * w x with hv
  have hw0 (x : ι) : 0 ≤ w x := Finset.sum_nonneg fun y _ ↦ mul_nonneg (hK x y).le (sq_nonneg _)
  have hwx (x : ι) : w x = ∑ y, K x y * u y ^ 2 - Ku x ^ 2 := by
    have hKux : Ku x = ∑ y, K x y * u y := rfl
    have hy (y : ι) : K x y * (u y - Ku x) ^ 2 =
        K x y * u y ^ 2 - 2 * Ku x * (K x y * u y) + Ku x ^ 2 * K x y := by ring
    simp only [hw, hy, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, hK1,
      ← hKux]
    ring
  have hσ : sigmaSq = v := by
    have h1 : v = ∑ x, π x * u x ^ 2 - ∑ x, π x * Ku x ^ 2 := by
      simp only [hv, hwx, mul_sub, Finset.sum_sub_distrib, Finset.mul_sum]
      congr 1
      rw [Finset.sum_comm]
      simp_rw [← mul_assoc, ← Finset.sum_mul, hstat]
    have h2 : v = ∑ x, π x * g x ^ 2 + 2 * ∑ x, π x * (g x * Ku x) := by
      rw [h1]
      have (x : ι) : u x = g x + Ku x := by linarith [hu x]
      simp_rw [this]
      simp only [add_sq, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
      rw [add_sub_cancel_right]
      congr 1
      exact Finset.sum_congr rfl fun x _ ↦ by ring
    have h3 : HasSum (fun k ↦ ∑ x, π x * (g x * Matrix.mulVec (K ^ (k + 1)) g x))
        (∑ x, π x * (g x * Ku x)) :=
      hasSum_sum fun x _ ↦ ((hKu x).mul_left (g x)).mul_left (π x)
    rw [h2, ← h3.tsum_eq]
    simp only [sigmaSq, hvar, hcov]
  rw [hσ]
  exact tendstoInDistribution_sqrt_mul_sampleAverage_sub_of_poisson μ X hX π K hπ hπ1 hK hK1
    hstat hstep f m u fun x ↦ by simpa [hg] using hu x

end Ergodic

end CKSD
