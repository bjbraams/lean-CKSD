module

public import CKSD.Learning.Algorithms
public import Mathlib.Probability.ProductMeasure
public import Mathlib.Probability.Distributions.Beta
public import Mathlib.Probability.Moments.SubGaussian
public import Mathlib.InformationTheory.KullbackLeibler.Basic
public import TauCeti.Probability.Quantile

/-!
# Stochastic bandits in the reward-table model

A stochastic bandit with `K` arms and reward laws `ν k` is realized on the reward table
`R : Fin K × ℕ → ℝ`, whose entries are independent with `R (k, j) ∼ ν k`; the `j`-th play of arm
`k` receives `R (k, j)`. A policy chooses the arm at time `t` as a measurable function of the
history of the first `t` arms and rewards and of an internal seed `u` with law `ρ`, independent
of the table. Every randomized strategy of the usual interaction protocol has a law on
histories of this form, and conversely, so regrets in the two descriptions coincide.

The regret after `n` plays is `n` times the optimal mean minus the expected total reward. Product
laws use Mathlib's `Measure.infinitePi`, Beta laws Mathlib's `betaMeasure`, and posterior
sampling TauCeti's quantile function (inverse transform sampling from uniform seeds).

Sources: GAPS 107.49, 107.51, 107.62, and 107.63.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators Matrix

namespace CKSD

attribute [local instance] Classical.propDecidable

/-- A seeded bandit policy: the arm at time `t` from the history of length `t` and a seed. -/
abbrev SeededBanditPolicy (K : ℕ) (U : Type*) :=
  ∀ t : ℕ, (Fin t → Fin K × ℝ) → U → Fin K

/-- Number of plays of arm `k` in a finite history. -/
def historyPlayCount {K t : ℕ} (h : Fin t → Fin K × ℝ) (k : Fin K) : ℕ :=
  (Finset.univ.filter fun i ↦ (h i).1 = k).card

/-- Total reward collected from arm `k` in a finite history. -/
def historyRewardSum {K t : ℕ} (h : Fin t → Fin K × ℝ) (k : Fin K) : ℝ :=
  ∑ i, if (h i).1 = k then (h i).2 else 0

/-- The history of the first `t` arms and rewards of a policy run on a reward table. -/
def banditHistory {K : ℕ} {U : Type*} (π : SeededBanditPolicy K U) (u : U)
    (R : Fin K × ℕ → ℝ) : ∀ t : ℕ, Fin t → Fin K × ℝ
  | 0 => Fin.elim0
  | t + 1 =>
    let h := banditHistory π u R t
    let a := π t h u
    Fin.snoc (α := fun _ ↦ Fin K × ℝ) h (a, R (a, historyPlayCount h a))

/-- The arm played at time `t`. -/
def banditArm {K : ℕ} {U : Type*} (π : SeededBanditPolicy K U) (u : U)
    (R : Fin K × ℕ → ℝ) (t : ℕ) : Fin K :=
  π t (banditHistory π u R t) u

/-- The reward received at time `t`. -/
def banditReward {K : ℕ} {U : Type*} (π : SeededBanditPolicy K U) (u : U)
    (R : Fin K × ℕ → ℝ) (t : ℕ) : ℝ :=
  R (banditArm π u R t, historyPlayCount (banditHistory π u R t) (banditArm π u R t))

/-- Law of the reward table: independent entries, with `R (k, j)` of law `ν k`. -/
def rewardTableLaw {K : ℕ} (ν : Fin K → Measure ℝ) : Measure (Fin K × ℕ → ℝ) :=
  Measure.infinitePi fun z : Fin K × ℕ ↦ ν z.1

/-- Mean reward of an arm. -/
def armMean {K : ℕ} (ν : Fin K → Measure ℝ) (k : Fin K) : ℝ := ∫ x, x ∂ν k

/-- Regret after `n` plays: `n` times the optimal mean minus the expected total reward. -/
def banditRegret {K : ℕ} {U : Type*} [MeasurableSpace U] (π : SeededBanditPolicy K U)
    (ρ : Measure U) (ν : Fin K → Measure ℝ) (n : ℕ) : ℝ :=
  n * (⨆ k, armMean ν k) -
    ∫ u, ∫ R, ∑ t ∈ Finset.range n, banditReward π u R t ∂rewardTableLaw ν ∂ρ

/-- Measurability of a seeded policy in the history and the seed. -/
def SeededBanditPolicy.IsMeasurable {K : ℕ} {U : Type*} [MeasurableSpace U]
    (π : SeededBanditPolicy K U) : Prop :=
  ∀ t, Measurable fun z : (Fin t → Fin K × ℝ) × U ↦ π t z.1 z.2

/-- Log-partition function of the natural exponential family generated by `λ`. -/
def expFamilyLogPartition (lam : Measure ℝ) (θ : ℝ) : ℝ :=
  Real.log (∫ x, Real.exp (θ * x) ∂lam)

/-- The member `exp(θx - b(θ)) λ(dx)` of the natural exponential family generated by `λ`. -/
def expFamilyLaw (lam : Measure ℝ) (θ : ℝ) : Measure ℝ :=
  lam.withDensity fun x ↦ ENNReal.ofReal (Real.exp (θ * x - expFamilyLogPartition lam θ))

/-- GAPS 107.49: the Lai–Robbins lower bound for exponential-family bandits. The base measure
`λ` is σ-finite and not concentrated at one point, the natural parameters range over the open
interval `(l, r)` on which `exp(θx)` is `λ`-integrable, and the policy is uniformly good: its
regret is `o(n^α)` for every `α > 0` at every configuration. An optimal arm has the largest
natural parameter `θ⋆`, and `liminf regret(n) / log n` is at least the Lai–Robbins sum,
stated as eventual domination of every smaller constant. -/
theorem lai_robbins_lower_bound {U : Type*} [MeasurableSpace U] (ρ : Measure U)
    [IsProbabilityMeasure ρ] (lam : Measure ℝ) [SigmaFinite lam]
    (hlam : ∀ x, lam {x}ᶜ ≠ 0) (l r : ℝ) (hlr : l < r)
    (hint : ∀ θ ∈ Ioo l r, Integrable (fun x ↦ Real.exp (θ * x)) lam)
    (K : ℕ) (hK : 0 < K) (π : SeededBanditPolicy K U) (hπ : π.IsMeasurable)
    (hgood : ∀ θ : Fin K → ℝ, (∀ k, θ k ∈ Ioo l r) → ∀ α > (0 : ℝ),
      Tendsto (fun n : ℕ ↦ banditRegret π ρ (fun k ↦ expFamilyLaw lam (θ k)) n / (n : ℝ) ^ α)
        atTop (𝓝 0))
    (θ : Fin K → ℝ) (hθ : ∀ k, θ k ∈ Ioo l r) :
    let ν := fun k ↦ expFamilyLaw lam (θ k)
    let θstar := ⨆ k, θ k
    let bound := ∑ k, if θ k < θstar then
      ((∫ x, x ∂expFamilyLaw lam θstar) - armMean ν k) /
        (InformationTheory.klDiv (ν k) (expFamilyLaw lam θstar)).toReal else 0
    ∀ c < bound, ∀ᶠ n : ℕ in atTop, c ≤ banditRegret π ρ ν n / Real.log n := by
  sorry

/-- The Bernoulli law on `{0, 1} ⊆ ℝ` with success probability `p`. -/
def banditBernoulli (p : ℝ) : Measure ℝ :=
  ENNReal.ofReal (1 - p) • Measure.dirac 0 + ENNReal.ofReal p • Measure.dirac 1

/-- Kullback–Leibler divergence between Bernoulli laws with parameters `p` and `q`. -/
def banditBernoulliKL (p q : ℝ) : ℝ :=
  p * Real.log (p / q) + (1 - p) * Real.log ((1 - p) / (1 - q))

/-- The first maximizing coordinate of a finite real vector (the arm `0` is never needed). -/
def banditFirstArgmax {K : ℕ} [NeZero K] (v : Fin K → ℝ) : Fin K :=
  if h : (Finset.univ.filter fun k ↦ ∀ j, v j ≤ v k).Nonempty then
    (Finset.univ.filter fun k ↦ ∀ j, v j ≤ v k).min' h else 0

/-- Thompson sampling with independent uniform priors for Bernoulli rewards: at time `t` each
arm draws from its Beta posterior `Beta(1 + successes, 1 + failures)` by inverse transform of
the uniform seed `u (t, k)`, and the largest draw is played (ties to the smallest index). -/
def thompsonPolicy (K : ℕ) [NeZero K] : SeededBanditPolicy K (ℕ × Fin K → ℝ) :=
  fun t h u ↦ banditFirstArgmax fun k ↦
    (betaMeasure (1 + historyRewardSum h k)
      (1 + historyPlayCount h k - historyRewardSum h k)).quantile (u (t, k))

/-- Law of the Thompson seeds: independent uniform variables on `[0,1]`. -/
def thompsonSeedLaw (K : ℕ) : Measure (ℕ × Fin K → ℝ) :=
  Measure.infinitePi fun _ : ℕ × Fin K ↦ volume.restrict (Icc (0 : ℝ) 1)

/-- GAPS 107.51, Thompson sampling: for Bernoulli arms with means in `(0,1)` and a unique
optimal arm, Thompson sampling with uniform priors attains the Lai–Robbins constant. -/
theorem tendsto_thompson_regret_div_log (K : ℕ) [NeZero K] (μ : Fin K → ℝ)
    (hμ : ∀ k, μ k ∈ Ioo 0 1) (star : Fin K) (hstar : ∀ k ≠ star, μ k < μ star) :
    Tendsto (fun n : ℕ ↦ banditRegret (thompsonPolicy K) (thompsonSeedLaw K)
        (fun k ↦ banditBernoulli (μ k)) n / Real.log n) atTop
      (𝓝 (∑ k, if k = star then 0 else (μ star - μ k) / banditBernoulliKL (μ k) (μ star))) := by
  sorry

/-- The UCB1 policy: each arm once, then a maximizer of `x̄ⱼ + √(2 log t / nⱼ)`. -/
def ucb1Policy (K : ℕ) [NeZero K] : SeededBanditPolicy K Unit :=
  fun t h _ ↦ if ht : t < K then ⟨t, ht⟩ else banditFirstArgmax fun k ↦
    historyRewardSum h k / historyPlayCount h k +
      Real.sqrt (2 * Real.log t / historyPlayCount h k)

/-- GAPS 107.62, lower bound: for `K ≥ 2` and `n > K / (4 log(4/3))`, every seeded (hence every
randomized) strategy has regret at least `(√2 - 1)√(nK)/√(32 log(4/3))` on some instance with
independent Bernoulli rewards. -/
theorem exists_bernoulli_banditRegret_ge {U : Type*} [MeasurableSpace U] (ρ : Measure U)
    [IsProbabilityMeasure ρ] (K : ℕ) (hK : 2 ≤ K) (π : SeededBanditPolicy K U)
    (hπ : π.IsMeasurable) (n : ℕ) (hn : (K : ℝ) / (4 * Real.log (4 / 3)) < n) :
    ∃ μ : Fin K → ℝ, (∀ k, μ k ∈ Icc 0 1) ∧
      (Real.sqrt 2 - 1) * Real.sqrt (n * K) / Real.sqrt (32 * Real.log (4 / 3)) ≤
        banditRegret π ρ (fun k ↦ banditBernoulli (μ k)) n := by
  sorry

/-- GAPS 107.62, upper bound: UCB1 has regret at most `C √(K n log n)` for all `n ≥ max(K, 2)`
and all reward laws on `[0,1]`, with a universal constant `C`. -/
theorem exists_ucb1_banditRegret_le :
    ∃ C > (0 : ℝ), ∀ (K : ℕ) [NeZero K], 2 ≤ K → ∀ ν : Fin K → Measure ℝ,
      (∀ k, IsProbabilityMeasure (ν k)) → (∀ k, ν k (Icc 0 1)ᶜ = 0) →
      ∀ n : ℕ, max K 2 ≤ n →
        banditRegret (ucb1Policy K) (Measure.dirac ()) ν n ≤
          C * Real.sqrt (K * n * Real.log n) := by
  sorry

/-- The regularized design matrix `V₀ + ∑_{1 ≤ i ≤ t} Xᵢ Xᵢᵀ`. -/
def selfNormalizedDesign {Ω : Type*} {d : ℕ} (V₀ : Matrix (Fin d) (Fin d) ℝ)
    (X : ℕ → Ω → Fin d → ℝ) (t : ℕ) (ω : Ω) : Matrix (Fin d) (Fin d) ℝ :=
  V₀ + ∑ i ∈ Finset.Icc 1 t, Matrix.vecMulVec (X i ω) (X i ω)

/-- GAPS 107.63, self-normalized bound (Abbasi-Yadkori–Pál–Szepesvári): with probability at
least `1 - δ`, simultaneously for all `t ≥ 1`,
`‖∑ᵢ Xᵢ εᵢ‖²_{Vₜ⁻¹} ≤ 2σ² log(det(Vₜ)^{1/2} det(V₀)^{-1/2} / δ)`. The noise `εₜ` is
`𝓕ₜ`-measurable and conditionally `σ`-sub-Gaussian given `𝓕ₜ₋₁`, and `Xₜ` is
`𝓕ₜ₋₁`-measurable. -/
theorem measure_exists_selfNormalized_gt_le {Ω : Type*} [MeasurableSpace Ω]
    [StandardBorelSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℕ (inferInstance : MeasurableSpace Ω)) (d : ℕ) (σ : ℝ≥0)
    (ε : ℕ → Ω → ℝ) (X : ℕ → Ω → Fin d → ℝ)
    (hε : ∀ t, StronglyMeasurable[F t] (ε t))
    (hX : ∀ t, 1 ≤ t → Measurable[F (t - 1)] (X t))
    (hsub : ∀ t, 1 ≤ t → HasCondSubgaussianMGF (F (t - 1)) (F.le _) (ε t) (σ ^ 2) P)
    (V₀ : Matrix (Fin d) (Fin d) ℝ) (hV₀ : V₀.PosDef) (δ : ℝ) (hδ : δ ∈ Ioo 0 1) :
    P.real {ω | ∃ t, 1 ≤ t ∧
      let S := ∑ i ∈ Finset.Icc 1 t, ε i ω • X i ω
      let V := selfNormalizedDesign V₀ X t ω
      2 * (σ : ℝ) ^ 2 * Real.log (Real.sqrt V.det / Real.sqrt V₀.det / δ) <
        S ⬝ᵥ (V⁻¹ *ᵥ S)} ≤ δ := by
  sorry

/-- GAPS 107.63, LinUCB regret for a finite decision set. Actions `xₜ ∈ 𝒟` are
`𝓕ₜ`-measurable and maximize `⟨μ̂ₜ, x⟩ + √βₜ ‖x‖_{Σₜ⁻¹}` for the ridge estimate `μ̂ₜ` with
`Σₜ = λ I + ∑_{τ<t} x_τ x_τᵀ`, `λ = σ²/W²`; observations are `⟨μ⋆, xₜ⟩ + ηₜ` with
`ηₜ` `𝓕ₜ₊₁`-measurable and conditionally `σ`-sub-Gaussian given `𝓕ₜ`. With probability at
least `1 - δ`, for all `T`, the regret is at most
`c σ √T (d log(1 + T B² W² / (d σ²)) + log(4/δ))`. The minimax lower bound `d√T/2500` is
not formalized here. -/
theorem exists_linUCB_regret_le :
    ∃ c > (0 : ℝ), ∀ {Ω : Type} [MeasurableSpace Ω] [StandardBorelSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (F : Filtration ℕ (inferInstance : MeasurableSpace Ω)) (d : ℕ) (hd : 0 < d)
      (D : Finset (Fin d → ℝ)) (hD : D.Nonempty) (μstar : Fin d → ℝ) (B W : ℝ) (σ : ℝ≥0),
      0 < B → 0 < W → 0 < σ → (∀ x ∈ D, |μstar ⬝ᵥ x| ≤ 1 ∧ ‖(WithLp.toLp 2 x :
        EuclideanSpace ℝ (Fin d))‖ ≤ B) →
      ‖(WithLp.toLp 2 μstar : EuclideanSpace ℝ (Fin d))‖ ≤ W →
      ∀ (x : ℕ → Ω → Fin d → ℝ) (η : ℕ → Ω → ℝ),
      (∀ t, Measurable[F t] (x t)) → (∀ t, StronglyMeasurable[F (t + 1)] (η t)) →
      (∀ t, HasCondSubgaussianMGF (F t) (F.le t) (η t) (σ ^ 2) P) →
      ∀ δ ∈ Ioo (0 : ℝ) 1,
      let lam : ℝ := (σ : ℝ) ^ 2 / W ^ 2
      let Sig := fun t ω ↦ lam • (1 : Matrix (Fin d) (Fin d) ℝ) +
        ∑ τ ∈ Finset.range t, Matrix.vecMulVec (x τ ω) (x τ ω)
      let μhat := fun t ω ↦ (Sig t ω)⁻¹ *ᵥ
        ∑ τ ∈ Finset.range t, (μstar ⬝ᵥ x τ ω + η τ ω) • x τ ω
      let β := fun t : ℕ ↦ (σ : ℝ) ^ 2 * (2 + 4 * d *
        Real.log (1 + t * B ^ 2 * W ^ 2 / (d * σ ^ 2)) + 8 * Real.log (4 / δ))
      let ucb := fun t ω y ↦ μhat t ω ⬝ᵥ y +
        Real.sqrt (β t) * Real.sqrt (y ⬝ᵥ ((Sig t ω)⁻¹ *ᵥ y))
      (∀ t ω, x t ω ∈ D ∧ ∀ y ∈ D, ucb t ω y ≤ ucb t ω (x t ω)) →
      1 - δ ≤ P.real {ω | ∀ T : ℕ,
        (∑ t ∈ Finset.range T, (D.sup' hD (fun y ↦ μstar ⬝ᵥ y) - μstar ⬝ᵥ x t ω)) ≤
          c * σ * Real.sqrt T *
            (d * Real.log (1 + T * B ^ 2 * W ^ 2 / (d * σ ^ 2)) + Real.log (4 / δ))} := by
  sorry

end CKSD
