module

public import CKSD.Asymptotics.QMDReference


/-!
# Semiparametric efficiency and adaptation

The semiparametric convolution bound is stated for a family of one-dimensional submodels
through a fixed law `P`, indexed by a parametric direction and a nuisance score taken from a
linear space `G` of `L²(P)` scores. Quadratic-mean differentiability is Statlib's
(through the adapter `HasQuadraticMeanDerivAt`), relative to a sigma-finite dominating measure.
This ensures that the Radon–Nikodym expressions represent the actual path laws; absolute
continuity alone does not suffice for an arbitrary nonsigma-finite reference measure. Efficient
scores use the orthogonal projection of `efficientScore`.

The center-of-symmetry results use a location family with an absolutely continuous symmetric
density. Sources: GAPS 102.34 and 102.41. Cross-fitted estimation of a missing mean
(GAPS 102.39) is in `CKSD.Asymptotics.CrossFitting`.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal Topology BigOperators

namespace CKSD

/-! ### Semiparametric convolution bound -/

/-- A score orthogonal to every nuisance score is its own efficient score. -/
theorem efficient_score_eq_self_of_inner_eq_zero {X : Type*} [MeasurableSpace X] (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) (s : Lp ℝ 2 P) (h : ∀ g ∈ scores, inner ℝ g s = 0) :
    efficientScore P scores s = s := by
  have hmem : s ∈ ((nuisanceTangentSpace P scores).toSubmodule)ᗮ := by
    change s ∈ ((Submodule.span ℝ scores).topologicalClosure)ᗮ
    rw [Submodule.orthogonal_closure, Submodule.mem_orthogonal]
    intro u hu
    induction hu using Submodule.span_induction with
    | mem x hx => exact h x hx
    | zero => simp
    | add x y _ _ hx hy => rw [inner_add_left, hx, hy, add_zero]
    | smul a x _ hx => rw [inner_smul_left, hx, mul_zero]
  unfold efficientScore
  rw [(Submodule.starProjection_apply_eq_zero_iff _).mpr hmem, sub_zero]


/-- Efficient information matrix `Ĩ_ij = ⟨ℓ̃_i, ℓ̃_j⟩` of a vector of `L²` scores, where `ℓ̃`
is the residual after projection on the nuisance tangent space generated by `scores`. -/
def efficientInformationMatrix {X : Type*} [MeasurableSpace X] {k : ℕ} (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) (ℓ : Fin k → Lp ℝ 2 P) : Matrix (Fin k) (Fin k) ℝ :=
  fun i j ↦ inner ℝ (efficientScore P scores (ℓ i)) (efficientScore P scores (ℓ j))

/-- Efficient influence function `Ĩ⁻¹ ℓ̃(x)`, evaluated at an observation through the chosen
representatives of the efficient scores. -/
def efficientInfluence {X : Type*} [MeasurableSpace X] {k : ℕ} (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) (ℓ : Fin k → Lp ℝ 2 P) (x : X) : EuclideanSpace ℝ (Fin k) :=
  Matrix.toEuclideanCLM (𝕜 := ℝ) (efficientInformationMatrix P scores ℓ)⁻¹
    (WithLp.toLp 2 fun i ↦ efficientScore P scores (ℓ i) x)

/-- Regularity of an estimator sequence along a family of one-dimensional submodels
`t ↦ Q i t` of probability measures whose parameter moves in direction `dir i`: under the
product law at `t = 1/√n`, `√n (Tₙ - (θ + dir i / √n))` converges in law to the same `L` for
every `i`. -/
def IsRegularAlongPaths {X ι : Type*} [MeasurableSpace X] {k : ℕ}
    (Q : ι → ℝ → Measure X) [∀ i t, IsProbabilityMeasure (Q i t)]
    (dir : ι → EuclideanSpace ℝ (Fin k)) (θ : EuclideanSpace ℝ (Fin k))
    (T : ∀ n, (Fin n → X) → EuclideanSpace ℝ (Fin k))
    (L : Measure (EuclideanSpace ℝ (Fin k))) [IsProbabilityMeasure L] : Prop :=
  (∀ n, Measurable (T n)) ∧ ∀ i, TendstoInDistribution
    (fun (n : ℕ) x ↦ Real.sqrt n • (T n x - (θ + (Real.sqrt n)⁻¹ • dir i))) atTop id
    (fun n ↦ Measure.pi fun _ : Fin n ↦ Q i (Real.sqrt n)⁻¹) L

/-- GAPS 102.34, convolution part. For every direction `a ∈ ℝᵏ` and nuisance score `g` in a
linear space `G ⊆ L²(P)`, the submodel `t ↦ Q (a, g) t` passes through `P` at `t = 0`, has
parameter `θ + t a`, is dominated by `ν`, and is QMD at `0` with score `a ⬝ ℓ̇ + g`. The
nuisance tangent space is the closure of `G`. If the efficient information matrix is positive
definite, the limit law of every estimator sequence regular along these submodels is the
convolution of `N(0, Ĩ⁻¹)` with a probability measure. The common reference measure `ν` is
sigma-finite, so its Radon–Nikodym densities represent every dominated path law. -/
theorem exists_convolution_of_is_regular_along_paths
    {X : Type*} [MeasurableSpace X] {k : ℕ} (P : Measure X) [IsProbabilityMeasure P]
    (ν : Measure X) [SigmaFinite ν] (θ : EuclideanSpace ℝ (Fin k)) (ℓ : Fin k → Lp ℝ 2 P)
    (G : Submodule ℝ (Lp ℝ 2 P))
    (Q : EuclideanSpace ℝ (Fin k) × G → ℝ → Measure X)
    (hQ : ∀ i t, IsProbabilityMeasure (Q i t)) (hQ0 : ∀ i, Q i 0 = P)
    (hQν : ∀ i t, Q i t ≪ ν)
    (hdqm : ∀ i, ∃ A : ℝ →ₗ[ℝ] Lp ℝ 2 (Q i 0), HasQuadraticMeanDerivAt (Q i) ν 0 A ∧
      ⇑(A 1) =ᵐ[P] ⇑(∑ j, i.1 j • ℓ j + (i.2 : Lp ℝ 2 P)))
    (hI : (efficientInformationMatrix P (G : Set (Lp ℝ 2 P)) ℓ).PosDef)
    (T : ∀ n, (Fin n → X) → EuclideanSpace ℝ (Fin k))
    (L : Measure (EuclideanSpace ℝ (Fin k))) [IsProbabilityMeasure L]
    (hreg : IsRegularAlongPaths Q Prod.fst θ T L) :
    ∃ M : Measure (EuclideanSpace ℝ (Fin k)), IsProbabilityMeasure M ∧
      L = (multivariateGaussian 0
        (efficientInformationMatrix P (G : Set (Lp ℝ 2 P)) ℓ)⁻¹).conv M := by
  sorry

/-- GAPS 102.34, efficiency part, in the setting of
`exists_convolution_of_is_regular_along_paths`. A measurable estimator sequence is regular along
all submodels with limit `N(0, Ĩ⁻¹)` if and only if it is asymptotically linear in the efficient
influence function under `P`. The common dominating reference measure `ν` is sigma-finite. -/
theorem is_regular_along_paths_gaussian_iff_asymptotically_linear
    {X : Type*} [MeasurableSpace X] {k : ℕ} (P : Measure X) [IsProbabilityMeasure P]
    (ν : Measure X) [SigmaFinite ν] (θ : EuclideanSpace ℝ (Fin k)) (ℓ : Fin k → Lp ℝ 2 P)
    (G : Submodule ℝ (Lp ℝ 2 P))
    (Q : EuclideanSpace ℝ (Fin k) × G → ℝ → Measure X)
    (hQ : ∀ i t, IsProbabilityMeasure (Q i t)) (hQ0 : ∀ i, Q i 0 = P)
    (hQν : ∀ i t, Q i t ≪ ν)
    (hdqm : ∀ i, ∃ A : ℝ →ₗ[ℝ] Lp ℝ 2 (Q i 0), HasQuadraticMeanDerivAt (Q i) ν 0 A ∧
      ⇑(A 1) =ᵐ[P] ⇑(∑ j, i.1 j • ℓ j + (i.2 : Lp ℝ 2 P)))
    (hI : (efficientInformationMatrix P (G : Set (Lp ℝ 2 P)) ℓ).PosDef)
    (T : ∀ n, (Fin n → X) → EuclideanSpace ℝ (Fin k)) (hT : ∀ n, Measurable (T n)) :
    IsRegularAlongPaths Q Prod.fst θ T
        (multivariateGaussian 0 (efficientInformationMatrix P (G : Set (Lp ℝ 2 P)) ℓ)⁻¹) ↔
      TendstoInProbabilityZero (fun n ↦ Measure.pi fun _ : Fin n ↦ P)
        (fun n x ↦ ‖Real.sqrt n • (T n x - θ) - (Real.sqrt n)⁻¹ •
          ∑ i, efficientInfluence P (G : Set (Lp ℝ 2 P)) ℓ (x i)‖) := by
  sorry

/-! ### Adaptive estimation of a center of symmetry -/

/-- Location law with density `η (x - θ)` with respect to Lebesgue measure. -/
def locationLaw (η : ℝ → ℝ) (θ : ℝ) : Measure ℝ :=
  volume.withDensity fun x ↦ ENNReal.ofReal (η (x - θ))

/-- Fisher information for location, `∫ η'² / η`, with the convention `η'²/0 = 0`. -/
def locationFisherInformation (η η' : ℝ → ℝ) : ℝ := ∫ x, η' x ^ 2 / η x

/-- Location score `-η'(x-θ)/η(x-θ)` of the location family at `θ`. -/
def locationScore (η η' : ℝ → ℝ) (θ x : ℝ) : ℝ := -(η' (x - θ) / η (x - θ))

/-- A symmetric probability density on the line that is absolutely continuous with locally
integrable derivative `η'`, chosen odd, and has finite Fisher information for location.
Choosing an odd version of the derivative is no restriction: the odd part of any version of the
derivative of an even absolutely continuous function is again a version. -/
structure IsSymmetricFiniteInformationDensity (η η' : ℝ → ℝ) : Prop where
  /-- The density is measurable. -/
  measurable : Measurable η
  /-- The density is nonnegative. -/
  nonneg : ∀ x, 0 ≤ η x
  /-- The density has total mass one. -/
  integral_eq_one : ∫ x, η x = 1
  /-- The density is symmetric about zero. -/
  symm : ∀ x, η (-x) = η x
  /-- The derivative is measurable. -/
  measurable_deriv : Measurable η'
  /-- The chosen version of the derivative is odd. -/
  deriv_odd : ∀ x, η' (-x) = -η' x
  /-- The derivative is locally integrable. -/
  intervalIntegrable_deriv : ∀ a b, IntervalIntegrable η' volume a b
  /-- Absolute continuity: the density is the integral of its derivative. -/
  eq_integral_deriv : ∀ x, η x = η 0 + ∫ t in (0 : ℝ)..x, η' t
  /-- Finite Fisher information for location. -/
  integrable_fisher : Integrable fun x ↦ η' x ^ 2 / η x

/-- The location laws of a symmetric finite-information density are probability measures. -/
theorem IsSymmetricFiniteInformationDensity.is_probability_measure_location_law {η η' : ℝ → ℝ}
    (hη : IsSymmetricFiniteInformationDensity η η') (θ : ℝ) :
    IsProbabilityMeasure (locationLaw η θ) := by
  have hint : Integrable η := by
    by_contra hni
    have h1 := hη.integral_eq_one
    rw [integral_undef hni] at h1
    exact zero_ne_one h1
  have hshift := lintegral_sub_right_eq_self (μ := volume) (fun x ↦ ENNReal.ofReal (η x)) θ
  constructor
  rw [locationLaw, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ, hshift,
    ← ofReal_integral_eq_lintegral_ofReal hint (ae_of_all _ hη.nonneg), hη.integral_eq_one,
    ENNReal.ofReal_one]

/-- Scores of symmetric nuisance perturbations at `P` about the centre `θ`: mean-zero `L²`
functions that are even about `θ`. -/
def symmetricNuisanceScores (P : Measure ℝ) (θ : ℝ) : Set (Lp ℝ 2 P) :=
  {g | (⇑g =ᵐ[P] fun x ↦ g (2 * θ - x)) ∧ ∫ x, g x ∂P = 0}

/-- The reflection `x ↦ 2θ - x` preserves a symmetric location law centred at `θ`. -/
theorem measure_preserving_reflect_location_law {η η' : ℝ → ℝ}
    (hη : IsSymmetricFiniteInformationDensity η η') (θ : ℝ) :
    MeasurePreserving (fun x ↦ 2 * θ - x) (locationLaw η θ) (locationLaw η θ) := by
  have hρ : MeasurePreserving (fun x : ℝ ↦ 2 * θ - x) volume volume :=
    Measure.measurePreserving_sub_left volume (2 * θ)
  refine ⟨hρ.measurable, ?_⟩
  ext A hA
  have hf : Measurable fun x ↦ ENNReal.ofReal (η (x - θ)) :=
    ENNReal.measurable_ofReal.comp (hη.measurable.comp (measurable_sub_const θ))
  rw [Measure.map_apply hρ.measurable hA, locationLaw, withDensity_apply _ (hρ.measurable hA),
    withDensity_apply _ hA, ← hρ.setLIntegral_comp_preimage hA hf]
  congr 1
  funext x
  rw [show 2 * θ - x - θ = -(x - θ) by ring, hη.symm]

/-- GAPS 102.41, efficient-score part: in the symmetric location model, with nuisance tangent
space the closed span of the mean-zero `L²` functions that are even about `θ` (the scores of
symmetric perturbations of `η`), the location score is orthogonal to the nuisance tangent space,
so it is the efficient score, and the efficient information is the Fisher information `I_η`. -/
theorem efficient_score_location_score_eq {η η' : ℝ → ℝ}
    (hη : IsSymmetricFiniteInformationDensity η η') (θ : ℝ)
    (hs : MemLp (locationScore η η' θ) 2 (locationLaw η θ)) :
    efficientScore (locationLaw η θ) (symmetricNuisanceScores (locationLaw η θ) θ)
        (hs.toLp _) = hs.toLp _ ∧
      efficientInformation (locationLaw η θ) (symmetricNuisanceScores (locationLaw η θ) θ)
        (hs.toLp _) = locationFisherInformation η η' := by
  set P := locationLaw η θ
  have hinner : ∀ a b : ℝ, inner ℝ a b = a * b := fun a b ↦ by
    rw [RCLike.inner_apply', conj_trivial]
  have hρ := measure_preserving_reflect_location_law hη θ
  have hodd : ∀ x, locationScore η η' θ (2 * θ - x) = -locationScore η η' θ x := by
    intro x
    simp only [locationScore]
    rw [show 2 * θ - x - θ = -(x - θ) by ring, hη.symm, hη.deriv_odd, neg_div]
  have heff : efficientScore P (symmetricNuisanceScores P θ) (hs.toLp _) = hs.toLp _ := by
    apply efficient_score_eq_self_of_inner_eq_zero
    intro g hg
    rw [MeasureTheory.L2.inner_def]
    set F : ℝ → ℝ := fun x ↦ inner ℝ (g x) ((hs.toLp _ : Lp ℝ 2 P) x)
    have hFae : F =ᵐ[P] fun x ↦ g x * locationScore η η' θ x := by
      filter_upwards [hs.coeFn_toLp] with x hx
      simp only [F, hx, hinner]
    have hFae' : (fun x ↦ F (2 * θ - x)) =ᵐ[P] fun x ↦ -F x := by
      have h1 := hρ.quasiMeasurePreserving.ae_eq_comp hFae
      filter_upwards [h1, hFae, hg.1] with x hx1 hx2 hx3
      simp only [Function.comp] at hx1
      rw [hx1, hx2, hodd, ← hx3]; ring
    have hemb : MeasurableEmbedding fun x : ℝ ↦ 2 * θ - x :=
      (MeasurableEquiv.subLeft (2 * θ)).measurableEmbedding
    have hint : ∫ x, F x ∂P = ∫ x, F (2 * θ - x) ∂P := (hρ.integral_comp hemb F).symm
    rw [integral_congr_ae hFae', integral_neg] at hint
    linarith
  refine ⟨heff, ?_⟩
  rw [efficientInformation, heff, ← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
  have h1 : (fun x ↦ inner ℝ ((hs.toLp _ : Lp ℝ 2 P) x) ((hs.toLp _ : Lp ℝ 2 P) x))
      =ᵐ[P] fun x ↦ locationScore η η' θ x ^ 2 := by
    filter_upwards [hs.coeFn_toLp] with x hx
    rw [hx, hinner, sq]
  rw [integral_congr_ae h1]
  have hf : Measurable fun x ↦ ENNReal.ofReal (η (x - θ)) :=
    ENNReal.measurable_ofReal.comp (hη.measurable.comp (measurable_sub_const θ))
  simp only [P, locationLaw]
  rw [integral_withDensity_eq_integral_toReal_smul hf (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
  have h2 : ∀ x, (ENNReal.ofReal (η (x - θ))).toReal • locationScore η η' θ x ^ 2 =
      (fun y ↦ η' y ^ 2 / η y) (x - θ) := by
    intro x
    rw [ENNReal.toReal_ofReal (hη.nonneg _), smul_eq_mul, locationScore]
    by_cases h0 : η (x - θ) = 0
    · simp [h0]
    · field_simp
  simp_rw [h2]
  rw [integral_sub_right_eq_self (fun y ↦ η' y ^ 2 / η y) θ]
  rfl

/-- GAPS 102.41, adaptation part: there are measurable estimators, not depending on the
symmetric density, that are asymptotically normal with the efficient variance `I_η⁻¹` at every
symmetric density of finite Fisher information, regularly along local location alternatives
`θ + h/√n`. The location laws are probability measures by
`IsSymmetricFiniteInformationDensity.is_probability_measure_location_law`; the instance binder only
makes them available to the statement. Regularity along symmetric nuisance perturbations is
outside this scope. -/
theorem exists_adaptive_estimator_center_of_symmetry :
    ∃ T : ∀ n, (Fin n → ℝ) → ℝ, (∀ n, Measurable (T n)) ∧
      ∀ η η' : ℝ → ℝ, IsSymmetricFiniteInformationDensity η η' →
        ∀ [∀ θ, IsProbabilityMeasure (locationLaw η θ)], ∀ θ h : ℝ,
        TendstoInDistribution (fun (n : ℕ) x ↦ Real.sqrt n * (T n x - (θ + h / Real.sqrt n)))
          atTop id
          (fun n ↦ Measure.pi fun _ : Fin n ↦ locationLaw η (θ + h / Real.sqrt n))
          (gaussianReal 0 (Real.toNNReal (locationFisherInformation η η')⁻¹)) := by
  sorry

end CKSD
