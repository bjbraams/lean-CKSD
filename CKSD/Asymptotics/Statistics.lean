module

public import CKSD.Asymptotics.Framework
public import Statlib.Inference.QMD


/-!
# Statistical functionals, cross-fitting, and resampling

Quadratic-mean differentiability is an adapter of Statlib's definition. Tangent spaces and
efficient scores use Mathlib's closed-span and orthogonal-projection constructions. Splitting
and resampling are explicit operations on samples; no asymptotic conclusions enter their definitions.
Sources: GAPS 102.11, 102.24–102.25, 102.34, 102.39–102.60.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal Topology BigOperators

namespace CKSD

/-- Quadratic-mean differentiability at a parameter, without a domain restriction, using Statlib. -/
abbrev HasQuadraticMeanDerivAt {X E : Type*} [MeasurableSpace X]
    [AddCommGroup E] [Module ℝ E] [TopologicalSpace E]
    (P : E → Measure X) (μ : Measure X) (θ : E)
    (score : E →ₗ[ℝ] Lp ℝ 2 (P θ)) : Prop :=
  QMD.HasQuadraticMeanDerivWithinAt P μ univ θ score

/-- Closed nuisance tangent space generated by a specified class of `L²` nuisance scores. -/
def nuisanceTangentSpace {X : Type*} [MeasurableSpace X] (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) : ClosedSubmodule ℝ (Lp ℝ 2 P) where
  __ := (Submodule.span ℝ scores).topologicalClosure
  isClosed' := (Submodule.span ℝ scores).isClosed_topologicalClosure

/-- Efficient score as the residual after projecting out the nuisance tangent space. -/
def efficientScore {X : Type*} [MeasurableSpace X] (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) (score : Lp ℝ 2 P) : Lp ℝ 2 P :=
  score - (nuisanceTangentSpace P scores).toSubmodule.starProjection score

/-- Efficient information for a scalar score. -/
def efficientInformation {X : Type*} [MeasurableSpace X] (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) (score : Lp ℝ 2 P) : ℝ :=
  ‖efficientScore P scores score‖ ^ 2

/-- Contamination path for a probability law and one contaminating observation. -/
def contaminationLaw {X : Type*} [MeasurableSpace X] (P : Measure X) (x : X) (ε : ℝ) : Measure X :=
  ENNReal.ofReal (1 - ε) • P + ENNReal.ofReal ε • Measure.dirac x

/-- Influence function as the right derivative of a statistical functional along contamination. -/
def influenceFunction {X : Type*} [MeasurableSpace X]
    (T : Measure X → ℝ) (P : Measure X) (x : X) : ℝ :=
  derivWithin (fun ε ↦ T (contaminationLaw P x ε)) (Ici 0) 0

/-- Missing-at-random augmented inverse-probability score. -/
def missingMeanScore {X : Type*} (m π : X → ℝ) (x : X) (observed : Bool) (y : ℝ) : ℝ :=
  m x + if observed then (y - m x) / π x else 0

/-- A finite partition of a sample into labeled folds. Empty folds are allowed in the definition. -/
structure SampleSplit (n K : ℕ) where
  /-- Fold label of each observation. -/
  fold : Fin n → Fin K

/-- Training indices for a fold are all indices outside that fold. -/
def SampleSplit.trainingIndices {n K : ℕ} (split : SampleSplit n K) (k : Fin K) : Set (Fin n) :=
  {i | split.fold i ≠ k}

/-- Cross-fitted average with nuisance estimates trained exclusively on the other folds. -/
def crossFittedAverage {X H : Type*} {n K : ℕ} (split : SampleSplit n K)
    (train : ∀ k : Fin K, (split.trainingIndices k → X) → H)
    (score : H → X → ℝ) (x : Fin n → X) : ℝ :=
  (∑ i, score (train (split.fold i) (fun j ↦ x j.val)) (x i)) / n

/-- Log likelihood of a finite iid sample with a given single-observation density. -/
def sampleLogLikelihood {Θ X : Type*} {n : ℕ} (f : Θ → X → ℝ)
    (x : Fin n → X) (θ : Θ) : ℝ := ∑ i, Real.log (f θ (x i))

/-- Likelihood-ratio statistic comparing two specified log-likelihood values. -/
def likelihoodRatioStatistic (unrestricted restricted : ℝ) : ℝ :=
  2 * (unrestricted - restricted)

/-- Wald quadratic statistic with the estimated covariance of the parameter estimate. -/
def waldStatistic {d : ℕ} (estimate target : EuclideanSpace ℝ (Fin d))
    (covariance : Matrix (Fin d) (Fin d) ℝ) : ℝ :=
  inner ℝ (estimate - target) (Matrix.toEuclideanCLM (𝕜 := ℝ) covariance⁻¹ (estimate - target))

/-- Score quadratic statistic with the information matrix of the whole sample. -/
def scoreStatistic {d : ℕ} (score : EuclideanSpace ℝ (Fin d))
    (information : Matrix (Fin d) (Fin d) ℝ) : ℝ :=
  inner ℝ score (Matrix.toEuclideanCLM (𝕜 := ℝ) information⁻¹ score)

/-- Conditional nonparametric bootstrap law of a statistic, given the observed sample.
For `n=0` this uses the zero empirical measure convention of `empiricalMeasure`. -/
def bootstrapLaw {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y] {n : ℕ}
    (statistic : (Fin n → X) → Y) (x : Fin n → X) : Measure Y :=
  (Measure.pi fun _ : Fin n ↦ empiricalMeasure n x).map statistic

/-- Standardization using an estimated standard deviation, with division-by-zero value zero. -/
def studentizedStatistic (n : ℕ) (estimate target standardDeviation : ℝ) : ℝ :=
  Real.sqrt n * (estimate - target) / standardDeviation

/-- Finite-order Edgeworth distribution-function approximation for supplied correction
polynomials. -/
def edgeworthApproximation (p : ℕ → Polynomial ℝ) (order n : ℕ) (x : ℝ) : ℝ :=
  cdf (gaussianReal 0 1) x + gaussianPDFReal 0 1 x *
    ∑ r ∈ Finset.range order, Real.rpow (n : ℝ) (-((r + 1 : ℕ) : ℝ) / 2) * (p (r + 1)).eval x

/-- Saddlepoint approximation to the sample-mean density, for a chosen solution of `K'(s)=x`. -/
def saddlepointDensity (K : ℝ → ℝ) (n : ℕ) (s x : ℝ) : ℝ :=
  Real.sqrt ((n : ℝ) / (2 * Real.pi * deriv (deriv K) s)) *
    Real.exp ((n : ℝ) * (K s - s * x))

/-- Efficient information is nonnegative. -/
theorem efficient_information_nonneg {X : Type*} [MeasurableSpace X] (P : Measure X)
    (scores : Set (Lp ℝ 2 P)) (score : Lp ℝ 2 P) : 0 ≤ efficientInformation P scores score :=
  sq_nonneg _

/-- A zero displacement gives a zero Wald statistic. -/
@[simp] theorem wald_statistic_self {d : ℕ} (θ : EuclideanSpace ℝ (Fin d))
    (C : Matrix (Fin d) (Fin d) ℝ) : waldStatistic θ θ C = 0 := by
  simp [waldStatistic]

end CKSD
